msgstr "Вернуть цвет, который был при открытии"

msgid "Color value"
msgstr "Значение цвета"

msgid "Color and brightness"
msgstr "Цвет и яркость"

msgid "Hue"
msgstr "Оттенок"

msgid "Opacity"
msgstr "Непрозрачность"


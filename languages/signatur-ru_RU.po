msgstr "Вернуть цвет по умолчанию"

msgid "Pick a color from the screen"
msgstr "Взять цвет с экрана"

msgid "Primary color"
msgstr "Основной цвет"

msgid "Secondary color"
msgstr "Дополнительный цвет"

msgid "Link color"
msgstr "Цвет ссылок"

